# No environment variables are needed for the demo or public live reads.
# CLI only; never paste keys into the browser. Set using your shell/secret manager.
# HEDERA_ACCOUNT_ID=0.0.your-testnet-account
# HEDERA_PRIVATE_KEY=your-testnet-key
# HEDERA_KEY_TYPE=ecdsa
# HCS_TOPIC_ID=0.0.your-topic
# Optional authenticated JSON-RPC relay, otherwise public Hashio is used.
# HEDERA_MAINNET_RPC_URL=https://mainnet.hashio.io/api
# HEDERA_TESTNET_RPC_URL=https://testnet.hashio.io/api
# HEDERA_EVM_PRIVATE_KEY=0xyour-testnet-evm-key
